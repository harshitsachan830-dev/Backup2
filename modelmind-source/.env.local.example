# MongoDB Atlas connection. Create a database user and restrict network access.
MONGODB_URI=mongodb+srv://<db-user>:<password>@<cluster-host>/
MONGODB_DB=modelmind

# Long random server-only secrets (at least 32 characters each).
OTP_HASH_SECRET=replace-with-a-random-secret-of-at-least-32-characters

# Brevo transactional-email API key and an approved sender address.
BREVO_API_KEY=replace-with-your-brevo-api-key
BREVO_SENDER_EMAIL=verified-sender@example.com

# Supabase keeps project rows and the user IDs referenced by existing RLS tables.
# Service-role key is server-only: never prefix it with NEXT_PUBLIC_.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=replace-with-your-supabase-service-role-key

# Comma-separated list of email addresses allowed to view /admin/users.
# This variable must remain server-only; do not prefix it with NEXT_PUBLIC_.
MODELMIND_ADMIN_EMAILS=admin@example.com

# Public HTTPS origin used to verify browser POST requests behind a reverse proxy.
MODELMIND_PUBLIC_ORIGIN=https://your-modelmind-domain.example

# Razorpay server credentials for the ₹99 one-time ModelMind purchase.
# Keep both values server-only; never prefix them with NEXT_PUBLIC_.
RAZORPAY_KEY_ID=rzp_test_replace_with_your_key_id
RAZORPAY_KEY_SECRET=replace-with-your-razorpay-key-secret
RAZORPAY_WEBHOOK_SECRET=replace-with-your-razorpay-webhook-secret

# Optional one-month demo coupon. Keep empty for paid launch.
MODELMIND_FREE_COUPON=

# The browser connects to its own computer's local notebook services.
# Do not replace these with a public code-execution API.
NEXT_PUBLIC_API_URL=http://127.0.0.1:8000
NEXT_PUBLIC_JUPYTER_URL=http://127.0.0.1:8899
