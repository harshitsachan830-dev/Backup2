# Copy this file to .env, then enter your API key locally.
# Set ML_PLATFORM_CLOUD_FALLBACK=enabled to permit Gemini fallback.
ML_PLATFORM_CLOUD_FALLBACK=disabled
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
# Comma-separated exact website origins permitted to call your local API.
# Example: MODELMIND_WEB_ORIGINS=https://your-modelmind-domain.example
MODELMIND_WEB_ORIGINS=